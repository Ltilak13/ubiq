{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spec record frontmatter",
  "type": "object",
  "required": ["term", "status"],
  "properties": {
    "term": {"type": "string", "pattern": "\\S"},
    "status": {"enum": ["draft", "accepted"]},
    "scenarios": {"type": "array", "items": {"type": "string"}}
  }
}
