{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goal frontmatter",
  "type": "object",
  "required": [
    "name",
    "status",
    "criteria"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "\\S"
    },
    "status": {
      "enum": [
        "proposed",
        "in-progress"
      ]
    },
    "issue": {
      "$ref": "#/$defs/tracking/properties/issue"
    },
    "priority": {
      "$ref": "#/$defs/tracking/properties/priority"
    },
    "criteria": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^AC[1-9][0-9]*$": {
          "type": "object",
          "required": [
            "assessment",
            "support",
            "gap"
          ],
          "properties": {
            "assessment": {
              "enum": [
                "unassessed",
                "partial",
                "met"
              ]
            },
            "support": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "feature",
                  "implementation",
                  "check"
                ],
                "properties": {
                  "feature": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "implementation": {
                    "$ref": "#/$defs/location"
                  },
                  "check": {
                    "$ref": "#/$defs/location"
                  }
                },
                "additionalProperties": false
              }
            },
            "gap": {
              "type": "string",
              "pattern": "\\S"
            },
            "review": {
              "type": "object",
              "required": [
                "by",
                "note"
              ],
              "properties": {
                "by": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "note": {
                  "type": "string",
                  "pattern": "\\S"
                }
              },
              "additionalProperties": false
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "uniqueItems": true
            },
            "issue": {
              "$ref": "#/$defs/tracking/properties/issue"
            },
            "priority": {
              "$ref": "#/$defs/tracking/properties/priority"
            },
            "requires": {
              "$ref": "#/$defs/tracking/properties/requires",
              "x-ubiq-ref": {
                "ns": "feature",
                "edge": "requires",
                "acyclic": true
              }
            },
            "part_of": {
              "$ref": "#/$defs/tracking/properties/part_of",
              "x-ubiq-ref": {
                "ns": "goal",
                "edge": "part_of",
                "single": true
              }
            },
            "pr": {
              "$ref": "#/$defs/tracking/properties/pr"
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "assessment": {
                    "const": "partial"
                  }
                }
              },
              "then": {
                "properties": {
                  "support": {
                    "minItems": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "assessment": {
                    "const": "met"
                  }
                }
              },
              "then": {
                "required": [
                  "review"
                ],
                "properties": {
                  "support": {
                    "minItems": 1
                  }
                }
              },
              "else": {
                "not": {
                  "required": [
                    "review"
                  ]
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "location": {
      "type": "object",
      "required": [
        "path",
        "anchor"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
        },
        "anchor": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "tracking": {
      "description": "Copy of .ubiq/schemas/tracking.json; a test keeps them equal.",
      "type": "object",
      "properties": {
        "issue": {
          "type": "integer",
          "minimum": 1
        },
        "priority": {
          "enum": [
            "P1",
            "P2",
            "P3"
          ]
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "part_of": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "pr": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
