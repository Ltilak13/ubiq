{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goal frontmatter",
  "type": "object",
  "required": [
    "name",
    "status",
    "criteria"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "\\S"
    },
    "status": {
      "$ref": "tracking.json#/properties/status"
    },
    "issue": {
      "$ref": "tracking.json#/properties/issue"
    },
    "priority": {
      "$ref": "tracking.json#/properties/priority"
    },
    "criteria": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^AC[1-9][0-9]*$": {
          "type": "object",
          "properties": {
            "scenario": {
              "description": "True when scenarios tagged with this label in <goal>.feature accept the criterion. The criterion then stores no assessment: it is met when every tagged scenario passes on main.",
              "const": true
            },
            "assessment": {
              "description": "`deferred` records that the criterion is deliberately not scheduled; `gap` says why. The sync closes its issues as not planned.",
              "enum": [
                "unassessed",
                "partial",
                "met",
                "deferred"
              ]
            },
            "support": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "feature",
                  "implementation",
                  "check"
                ],
                "properties": {
                  "feature": {
                    "description": "The feature record that supplies this evidence, by name.",
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                    "x-ubiq-ref": {
                      "ns": "feature",
                      "edge": "supported_by"
                    }
                  },
                  "implementation": {
                    "$ref": "#/$defs/location"
                  },
                  "check": {
                    "$ref": "#/$defs/location"
                  }
                },
                "additionalProperties": false
              }
            },
            "gap": {
              "type": "string",
              "pattern": "\\S"
            },
            "assessed_in": {
              "description": "The criterion that owns this obligation and its assessment. This criterion keeps its label and gets no evidence or issue of its own.",
              "type": "object",
              "required": [
                "goal",
                "criterion"
              ],
              "properties": {
                "goal": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                  "x-ubiq-ref": {
                    "ns": "goal",
                    "edge": "assessed_in"
                  }
                },
                "criterion": {
                  "type": "string",
                  "pattern": "^AC[1-9][0-9]*$"
                }
              },
              "additionalProperties": false
            },
            "review": {
              "type": "object",
              "required": [
                "by",
                "note",
                "at",
                "date"
              ],
              "properties": {
                "by": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "note": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "at": {
                  "description": "The commit the reviewer checked. Files cited in support that change after it make the review stale.",
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "date": {
                  "description": "The day of the review, as YYYY-MM-DD.",
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                }
              },
              "additionalProperties": false
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "uniqueItems": true
            },
            "issue": {
              "$ref": "tracking.json#/properties/issue"
            },
            "priority": {
              "$ref": "tracking.json#/properties/priority"
            },
            "requires": {
              "$ref": "tracking.json#/properties/requires",
              "x-ubiq-ref": {
                "ns": "feature",
                "edge": "requires",
                "acyclic": true
              }
            },
            "part_of": {
              "$ref": "tracking.json#/properties/part_of",
              "x-ubiq-ref": {
                "ns": "goal",
                "edge": "part_of",
                "single": true
              }
            },
            "pr": {
              "$ref": "tracking.json#/properties/pr"
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "required": [
                  "scenario"
                ]
              },
              "then": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "assessment"
                      ]
                    },
                    {
                      "required": [
                        "support"
                      ]
                    },
                    {
                      "required": [
                        "gap"
                      ]
                    },
                    {
                      "required": [
                        "review"
                      ]
                    },
                    {
                      "required": [
                        "assessed_in"
                      ]
                    }
                  ]
                }
              },
              "else": {
                "required": [
                  "assessment",
                  "support",
                  "gap"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "assessment": {
                    "const": "partial"
                  }
                },
                "required": [
                  "assessment"
                ]
              },
              "then": {
                "properties": {
                  "support": {
                    "minItems": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "assessment": {
                    "const": "met"
                  }
                },
                "required": [
                  "assessment"
                ]
              },
              "then": {
                "required": [
                  "review"
                ],
                "properties": {
                  "support": {
                    "minItems": 1
                  }
                }
              },
              "else": {
                "not": {
                  "required": [
                    "review"
                  ]
                }
              }
            },
            {
              "if": {
                "required": [
                  "assessed_in"
                ]
              },
              "then": {
                "properties": {
                  "assessment": {
                    "const": "unassessed"
                  },
                  "support": {
                    "maxItems": 0
                  }
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "location": {
      "type": "object",
      "required": [
        "path",
        "anchor"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
        },
        "anchor": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    }
  }
}
