{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tracking fields",
  "type": "object",
  "properties": {
    "issue": {"type": "integer", "minimum": 1},
    "priority": {"enum": ["P1", "P2", "P3"]},
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "\\S"}
    },
    "part_of": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "\\S"}
    },
    "pr": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    }
  }
}
