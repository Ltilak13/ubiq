{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill catalog",
  "type": "object",
  "required": ["skills"],
  "properties": {
    "skills": {"type": "array", "items": {"type": "string", "pattern": "^skills/[a-z0-9-]+$"},
               "minItems": 1, "uniqueItems": true}
  },
  "additionalProperties": false
}
