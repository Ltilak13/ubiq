{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feature frontmatter",
  "type": "object",
  "required": ["name", "requires", "codes", "config", "docs", "summary"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
      "x-ubiq-ref": {"ns": "feature", "edge": "requires", "acyclic": true}
    },
    "codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[EW][0-9]{3}$"}
    },
    "config": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z_]+(\\.[a-z_]+)*$"}
    },
    "docs": {"type": "string", "pattern": "^docs/[A-Za-z0-9_./-]+\\.md(#[a-z0-9-]+)?$"},
    "summary": {"type": "string", "pattern": "\\S"},
    "issue": {"$ref": "#/$defs/tracking/properties/issue"},
    "priority": {"$ref": "#/$defs/tracking/properties/priority"},
    "part_of": {
      "$ref": "#/$defs/tracking/properties/part_of",
      "x-ubiq-ref": {"ns": "feature", "edge": "part_of", "single": true}
    },
    "pr": {"$ref": "#/$defs/tracking/properties/pr"}
  },
  "additionalProperties": false,
  "$defs": {
    "tracking": {
      "description": "Copy of .ubiq/schemas/tracking.json; a test keeps them equal.",
      "type": "object",
      "properties": {
        "issue": {"type": "integer", "minimum": 1},
        "priority": {"enum": ["P1", "P2", "P3"]},
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "\\S"}
        },
        "part_of": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "\\S"}
        },
        "pr": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
