{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feature frontmatter",
  "type": "object",
  "required": ["name", "requires", "codes", "config", "docs", "summary"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
      "x-ubiq-ref": {"ns": "feature", "edge": "requires", "acyclic": true}
    },
    "codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[EW][0-9]{3}$"}
    },
    "config": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z_]+(\\.[a-z_]+)*$"}
    },
    "docs": {"type": "string", "pattern": "^docs/[A-Za-z0-9_./-]+\\.md(#[a-z0-9-]+)?$"},
    "summary": {"type": "string", "pattern": "\\S"},
    "status": {
      "enum": ["planned", "shipped"],
      "default": "shipped",
      "description": "planned: work in flight, not yet adoptable; shipped (the default when absent): released. A planned feature's codes need not be documented in the spec until it ships."
    },
    "issue": {"$ref": "tracking.json#/properties/issue"},
    "priority": {"$ref": "tracking.json#/properties/priority"},
    "part_of": {
      "$ref": "tracking.json#/properties/part_of",
      "x-ubiq-ref": {"ns": "feature", "edge": "part_of", "single": true}
    },
    "pr": {"$ref": "tracking.json#/properties/pr"}
  },
  "additionalProperties": false
}
